{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "extends": [
    "@charcuterie/biome-config",
    "@charcuterie/biome-config/app"
  ],
  "files": {
    "includes": [
      "biome.json",
      "eslint.config.mjs",
      "web/**",
      "server/**",
      "shared/**",
      "e2e/**",
      "!e2e/fixtures",
      "!e2e/playwright-report",
      "!e2e/test-results",
      "!**/node_modules",
      "!**/dist",
      "!web/public",
      "!web/index.html"
    ]
  },
  "overrides": [
    {
      "includes": ["web/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": {
              "level": "error",
              "options": {
                "inputComponents": [
                  "CheckboxGroup",
                  "SearchDropdown",
                  "SelectListbox"
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["e2e/**"],
      "assist": {
        "actions": {
          "source": {
            "organizeImports": "off"
          }
        }
      }
    }
  ]
}
