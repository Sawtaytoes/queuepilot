__pycache__/
*.pyc
# NO trailing slash, deliberately. `node_modules/` matches a DIRECTORY only, so a
# node_modules SYMLINK — which is how an agent shares one install between worktrees —
# sails straight past it and `git add -A` commits it as a 120000 blob. That is not
# hypothetical: it landed in main and broke the Docker build, because `COPY server ./server`
# cannot replace the image's real node_modules directory with a symlink file.
node_modules
web/node_modules
.env
.env.local
*.local
__screenshots__/
web/dist/
# The derived Plex cache (decision 2026-08-03-sqlite-is-a-derived-plex-cache-not-the-store):
# regenerable from Plex, never backed up, safe to delete.
cache.sqlite
cache.sqlite-wal
cache.sqlite-shm

# D3 engine-parity corpus (docs/d3-engine-parity-corpus.md): real library data, never committed.
__corpus__/

