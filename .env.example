# queuepilot env — copy to the TrueNAS app config (NOT committed; secrets live only here).

# --- Plex ---
PLEX_API_SERVER_URL=https://plex.example.com
PLEX_TOKEN=                       # the OWNER/admin token (plex.tv PIN flow); used to mint
                                  # per-account (Kids/Alice) tokens. See DEPLOY.md.
PLEX_CLIENT_IDENTIFIER=plex-channels-helper   # stable id for the managed-user token exchange
# WATCH_COUNT_ACCOUNTS=1,220339333,348723892   # union for watched/seen-once (default shown)

# --- Playback target (Family Room theater Shield) ---
PLAYBACK_MODE=cast                # cast = Plex Cast as the account token (correct-account
                                  # attribution, recommended). client = remote-control the app.
SHIELD_CAST_NAME=Family Room SHIELD   # Google-Cast friendly name of the Shield (cast mode)
# client-mode only:
SHIELD_CLIENT_MACHINE_ID=
SHIELD_CLIENT_NAME=Family Room SHIELD

# --- MQTT (Mosquitto HA add-on) ---
MQTT_HOST=                        # e.g. the HA host IP running the Mosquitto add-on
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# --- Soundtrack resolver (Living-Room card; optional, Phase 4) ---
# MA_URL=
# MA_TOKEN=
# OLLAMA_URL=http://192.0.2.6:11434
# OLLAMA_MODEL=gemma3:4b

# --- Web UI (queuepilot-web, same container) ---
WEB_PORT=8768                     # host port the Node queue editor binds (host-networked).
                                  # NPM proxies queuepilot.example.com -> 192.0.2.6:8768.

# --- Board-game collection sync (all optional) ---
#
# The four nightly steps run on `board-game-picker/cmd/sync` and answer on
# `.../resp/sync`. Home Assistant owns the schedule and publishes that tick; there is no
# cron. A step with no credentials is SKIPPED, not failed — none of these is required, and a
# container with none of them configured is a working app.
#
# BOARD_GAME_GEEK_API_TOKEN=       # BGG has required a token on the XML API since 2025-07-02;
#                                  # without one every call answers 401. Register an
#                                  # application at boardgamegeek.com/applications.
# BGG_USERNAME=                    # whose collection to sync
# KAVITA_RULEBOOK_LIBRARY_ID=1     # which Kavita library holds the rulebook PDFs. The base URL
#                                  # and API key are KAVITA_URL / the Kavita provider token —
#                                  # this linker adds no second credential.
#
# Paths. All three default beside QUEUES_PATH and rarely need setting; the staging tool put
# the artwork and the upstream cache there.
# BOARD_GAME_IMAGES_PATH=          # default <config>/board-game-images
# BOARD_GAME_CACHE_PATH=           # default <config>/board-game-cache — the ROOT, not the
#                                  # geekdo directory inside it.
# BOARD_GAME_MQTT_BASE=board-game-picker   # ⚠️ changing this silently stops the nightly: the
#                                  # HA automation publishes to the old topic and nobody
#                                  # answers. Move the HA package in the same change.
#
# BOARD_GAME_TRANSPORT=repository  # `http` is the rollback — it puts the provider's reads AND
#                                  # its play write back on the sibling app's wire.

# --- Tunables ---
# ROTATION_LENGTH=12
