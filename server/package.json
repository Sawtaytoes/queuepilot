{
  "name": "queuepilot-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API + static-frontend server for queuepilot (queues.yaml/sets.yaml editing, MQTT bridge). This is the whole application; the frontend lives in ../web.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build-server.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:prod": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@charcuterie/server": "^0.2.0",
    "@hono/node-server": "^2.0.2",
    "hono": "^4.12.21",
    "mqtt": "^5.15.2",
    "undici": "^7.29.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@charcuterie/tsconfig": "^1.0.0",
    "@types/node": "^25.6.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.3",
    "typescript": "^6.0.3"
  }
}
