{
  "extends": "@charcuterie/tsconfig/react",
  "compilerOptions": {
    // `/react` already gives: strict, isolatedModules, esModuleInterop,
    // resolveJsonModule, skipLibCheck, forceConsistentCasingInFileNames,
    // useDefineForClassFields, jsx: react-jsx, noEmit,
    // allowImportingTsExtensions, module/moduleResolution ESNext+Bundler,
    // and lib DOM + DOM.Iterable + ESNext.
    //
    // Everything below is this app's own 20%.
    "exactOptionalPropertyTypes": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // ES2023, not the base's ESNext: this bundle ships to real browsers
    // through Vite, and the target is what bounds the downlevelling.
    "target": "ES2023",
    // Empty, deliberately — mirrors rip-deck's and gallery-downloader's
    // browser programs. Leaving the Node types out is what makes an
    // accidental `node:fs` import in a component a typecheck failure
    // rather than a blank page. `vite/client` arrives through the
    // triple-slash reference in `src/vite-env.d.ts`.
    "types": [],
    "verbatimModuleSyntax": true
  },
  "include": [
    "src",
    "vite",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
