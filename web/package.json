{
  "name": "queuepilot-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "React 19 + TypeScript + Vite + Tailwind v4 frontend for queuepilot. Built to web/dist, which the Node server serves as its static root.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "biome check --write",
    "lint:biome": "biome check",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@charcuterie/logic": "^2.0.0",
    "@charcuterie/tokens": "^1.5.0",
    "@charcuterie/ui": "^2.15.1",
    "@tanstack/react-query": "^5.100.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@charcuterie/biome-config": "^1.0.0",
    "@charcuterie/server": "^0.2.0",
    "@charcuterie/tsconfig": "^1.0.0",
    "@charcuterie/vite-config": "^1.0.2",
    "@charcuterie/vitest-config": "^1.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
